// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 7 Pro (cheetah) - M1 bring-up board file.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include "gs201.dtsi"

/ {
	model = "Google Pixel 7 Pro";
	compatible = "google,gs201-cheetah", "google,gs201";

	/*
	 * ABL base-DTB match: (product id 0x09855000 | major rev). B0 = 1.
	 * Ship a second copy with 0x09855000 in the dtb section to be safe.
	 */
	soc_id = <0x09855001 0x0>;

	aliases {
		spi0 = &spi_0;
	};

	chosen {
		/* ABL requires bootargs to exist; it appends its own after these. */
		bootargs = "console=tty0 fbcon=font:TER16x32 quiet splash panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omandroid.ufs-probe";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		framebuffer0: framebuffer@fac00000 {
			compatible = "simple-framebuffer";
			memory-region = <&cont_splash_mem>;
			width = <1440>;
			height = <3120>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel>;
		};
	};

	/*
	 * The Samsung S6E3HC4 command-mode OLED. No driver yet: the bootloader
	 * leaves it running for simplefb, which reads its physical size here.
	 */
	panel: panel {
		compatible = "samsung,s6e3hc4";
		width-mm = <71>;
		height-mm = <155>;
		status = "disabled";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		/*
		 * PMIC_PWRON_OD_L: the S2MPG12 PWRONB line, also wired to the
		 * SoC. The PMIC's own long-press reset is unaffected.
		 */
		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * UFS VCC. Google drives it from GPIO gpp0-1 (boot-on); there is no
	 * gs201 GPIO driver yet, so describe it as always on, as the
	 * bootloader leaves it.
	 */
	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		regulator-always-on;
		regulator-boot-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/* [I] verify against the ABL-injected node in /sys/firmware/fdt */
		/*
		 * Same region and layout as stock Android, so a log written by
		 * this kernel can be read from /sys/fs/pstore after a warm
		 * reboot into the stock slot.
		 */
		ramoops@fd3ff000 {
			compatible = "ramoops";
			reg = <0x0 0xfd3ff000 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		cont_splash_mem: splash@fac00000 {
			reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;
			no-map;
		};
	};
};

&gpu {
	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
	status = "okay";
};

/* Touchscreen: Synaptics S3908 on USI0 SPI */
&usi0 {
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};

&spi_0 {
	pinctrl-0 = <&spi0_bus &spi0_miso &spi0_cs_gpio>;
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	num-cs = <1>;
	status = "okay";

	/*
	 * The 1.8 V (VDD) and 3.3 V (AVDD) supplies are S2MPG12 LDO25M and
	 * LDO26M. There is no S2MPG12 regulator driver yet; the bootloader
	 * leaves both on.
	 */
	touchscreen@0 {
		compatible = "syna,s3908";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&ts_irq &ts_reset>;
		pinctrl-names = "default";
		touchscreen-x-mm = <71>;
		touchscreen-y-mm = <154>;
	};
};

&usbdrd31_phy {
	status = "okay";
};

&usb_dwc3 {
	status = "okay";
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};
