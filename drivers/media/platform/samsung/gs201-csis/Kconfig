config VIDEO_GS201_CSIS
	tristate "Google gs201 CSIS camera receiver and WDMA"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV && OF
	depends on ARCH_EXYNOS || COMPILE_TEST
	select MEDIA_CONTROLLER
	select V4L2_FWNODE
	select VIDEO_V4L2_SUBDEV_API
	select VIDEOBUF2_DMA_CONTIG
	select GENERIC_PHY_MIPI_DPHY
	help
	  The MIPI CSI-2 receiver links (CSIS) of the Google gs201 (Tensor G2)
	  camera block and the CSIS WDMA that writes their raw frames to
	  memory, without the rest of the ISP.

	  To compile this driver as a module, choose M here: the module will
	  be called gs201-csis.
